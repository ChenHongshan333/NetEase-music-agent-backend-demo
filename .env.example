# Copy to .env (which is gitignored) or export these in your shell.
# Only DASHSCOPE_API_KEY is required, and only when agent.llm.provider=dashscope.

# ---- LLM ----
# DashScope (Alibaba Qwen) API key. Required for the dev/prod default provider.
# Not needed at all when running with the dev or test profile, which use the stub.
DASHSCOPE_API_KEY=

# Override the provider without touching a properties file: dashscope | stub
# stub returns a fixed answer with no network call. Used by the dev/test
# profiles and by benchmarks/bench.py when measuring throughput.
AGENT_LLM_PROVIDER=dashscope

# ---- Profile ----
# dev  = H2 in memory, cache off, LLM stub. Zero external dependencies.
# prod = MySQL + Redis (docker compose), cache on, real DashScope.
# test = same as dev, used by CI.
SPRING_PROFILES_ACTIVE=dev

# ---- Infrastructure (prod profile; defaults match docker-compose.yml) ----
# Uncomment only if you deviate from docker-compose.yml.
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/cs_agent?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
# SPRING_DATASOURCE_USERNAME=cs
# SPRING_DATASOURCE_PASSWORD=cs_pass
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379
